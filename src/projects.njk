---
layout: base.njk
title: "All Projects | Hussain Gaddal"
description: "A comprehensive list of all my Android, Kotlin Multiplatform, and backend projects."
---
<style>
    /* Scoped to this page only: free the outer main wrapper so cards can use full width */
    body > main { max-width: none !important; padding-left: 0 !important; padding-right: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important; }
</style>
<main class="pt-32 pb-24 px-4 sm:px-6 max-w-7xl mx-auto">
    <header class="mb-12 text-center fade-section">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">{{ locales.en.page_projects_title | safe }}</h1>
        <p class="text-xl text-ide-text-muted font-light max-w-2xl mx-auto">{{ locales.en.page_projects_desc }}</p>
    </header>

    <!-- Filters -->
    <div class="flex flex-wrap justify-center gap-3 mb-16 fade-section" id="project-filters" role="toolbar" aria-label="Project category filters">
        <button class="filter-btn active" data-filter="all" aria-pressed="true"><span>{{ locales.en.filter_all }}</span><span class="filter-count" aria-hidden="true">0</span></button>
        <button class="filter-btn" data-filter="kmp" aria-pressed="false"><span>KMP</span><span class="filter-count" aria-hidden="true">0</span></button>
        <button class="filter-btn" data-filter="cmp" aria-pressed="false"><span>CMP</span><span class="filter-count" aria-hidden="true">0</span></button>
        <button class="filter-btn" data-filter="android" aria-pressed="false"><span>Android</span><span class="filter-count" aria-hidden="true">0</span></button>
        <button class="filter-btn" data-filter="wear os" aria-pressed="false"><span>Wear OS</span><span class="filter-count" aria-hidden="true">0</span></button>
        <button class="filter-btn" data-filter="firebase" aria-pressed="false"><span>Firebase</span><span class="filter-count" aria-hidden="true">0</span></button>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="projects-grid">
        {% for project in projects %}
        <div class="project-card-wrapper fade-section" data-tags="{{ project.tags | join(',') | lower }}">
            <a href="{{ ('/' + project.slug + '/') | url }}" class="bento-card project-card-split group bento-animate {{ project.grid.glow }} glass-noise relative overflow-hidden rounded-3xl border border-ide-border flex flex-col sm:flex-row min-h-full">
                <div class="project-card-visual relative w-full sm:w-[45%] h-[200px] sm:h-auto sm:min-h-[220px] flex-shrink-0 overflow-hidden">
                    {% if project.grid.images %}
                    <img src="{{ project.grid.images.en.light | url }}" alt="" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.05] dark:hidden">
                    <img src="{{ project.grid.images.en.dark | url }}" alt="" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.05] hidden dark:block">
                    {% elif project.grid.image %}
                    <img src="{{ project.grid.image | url }}" alt="" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.05]">
                    {% else %}
                    <div class="absolute inset-0 flex items-center justify-center">
                        <i class="ph {{ project.grid.icon }} text-8xl {{ project.grid.iconColor }} relative z-10 transition-transform duration-500 group-hover:scale-110 group-hover:-rotate-3" aria-hidden="true"></i>
                    </div>
                    {% endif %}
                </div>

                <div class="relative z-20 flex-1 flex flex-col justify-center gap-3 p-6 sm:p-7 bg-ide-surface min-w-0">
                    <div class="flex gap-2 flex-wrap">
                        {% for tag in project.tags.slice(0, 3) %}
                        <span class="tech-pill text-xs shadow-none">{{ tag }}</span>
                        {% endfor %}
                        {% if project.tags.length > 3 %}
                        <span class="tech-pill text-xs shadow-none">+{{ project.tags.length - 3 }}</span>
                        {% endif %}
                    </div>
                    <h4 class="text-xl sm:text-2xl font-bold group-hover:text-ide-text-strong transition-colors">{{ project.title_en }}</h4>
                    <p class="text-ide-text-muted font-light text-sm sm:text-base leading-relaxed">{{ project.description_en }}</p>
                </div>
            </a>
        </div>
        {% endfor %}
    </div>

    <div id="projects-empty" class="hidden text-center py-16 text-ide-text-muted text-lg" role="status" aria-live="polite">{{ locales.en.filter_empty }}</div>
</main>

<script src="{{ '/js/projects-filter.js' | url }}"></script>
