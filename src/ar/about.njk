---
layout: base_rt_ar.njk
title: "نبذة عن حسين قدال | الخبرات والمسيرة المهنية"
seo_description: "مطوّر أندرويد بخبرة +٤ سنوات في كيه لتقنية المعلومات — Kotlin و Jetpack Compose و KMP وخدمات Ktor الخلفية. الخبرات والتعليم والشهادات."
---
{% set about = about_page.ar %}

<!-- ───────── Hero ───────── -->
<header class="max-w-7xl mx-auto px-6 pt-32 pb-16 lg:pt-40 lg:pb-24">
    <div class="grid lg:grid-cols-[1.4fr_1fr] gap-12 lg:gap-16 items-center">
        <!-- Intro -->
        <div>
            <div class="font-mono text-xs uppercase tracking-[0.18em] text-rt-muted mb-4">{{ about.hero.eyebrow }}</div>
            <h1 class="rt-em text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.08] tracking-tight mb-6">{{ about.hero.headline | safe }}</h1>
            <p class="text-lg text-rt-muted leading-relaxed max-w-xl mb-5">{{ about.hero.lede | safe }}</p>
            {% if about.hero.personal %}<p class="text-base text-rt-muted leading-relaxed max-w-xl mb-8">{{ about.hero.personal | safe }}</p>{% endif %}
            <div class="flex flex-wrap items-center gap-3">
                <a href="{{ '/ar/projects/' | url }}" class="inline-flex items-center gap-2 bg-rt-accent text-rt-btn-text font-semibold px-5 py-3 rounded-[10px] hover:brightness-110 hover:-translate-y-0.5 transition-all">
                    {{ about.hero.cta_work }} <span class="font-mono">←</span>
                </a>
                <a href="{{ '/cv/Hussain_Gaddal_CV.pdf' | url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-rt-border text-rt-text font-medium px-5 py-3 rounded-[10px] hover:border-rt-accent transition-colors">
                    <i class="ph ph-file-pdf"></i> {{ about.hero.cta_cv }}
                </a>
                <a href="mailto:hussain.yg2010@gmail.com" class="inline-flex items-center gap-2 border border-rt-border text-rt-text font-medium px-5 py-3 rounded-[10px] hover:border-rt-accent transition-colors">
                    <i class="ph ph-envelope-simple"></i> {{ about.hero.cta_contact }}
                </a>
            </div>
        </div>

        <!-- Portrait card + quick facts -->
        <div class="rt-card border border-rt-border rounded-2xl overflow-hidden bg-rt-surface transition-all duration-300">
            <img src="{{ '/assets/img/hussain-portrait.webp' | url }}" alt="{{ about.hero.portrait_alt }}"
                 width="2400" height="1600" fetchpriority="high"
                 class="w-full aspect-[4/5] object-cover" style="object-position: 28% 20%;">
            <div class="grid grid-cols-2 gap-x-4 gap-y-4 p-5 border-t border-rt-border">
                {% for row in about.hero.quick %}
                <div>
                    <div class="font-mono text-[10px] uppercase tracking-[0.06em] text-rt-muted">{{ row.k }}</div>
                    <div class="text-sm text-rt-text mt-1"><bdi>{{ row.v | safe }}</bdi></div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</header>

<!-- ───────── Experience timeline ───────── -->
<section id="experience" class="border-t border-rt-border">
    <div class="max-w-7xl mx-auto px-6 py-16 lg:py-20">
        <div data-reveal class="flex items-end justify-between gap-6 flex-wrap mb-10 lg:mb-12">
            <div>
                <div class="font-mono text-xs uppercase tracking-[0.1em] text-rt-muted mb-2">{{ about.experience.eyebrow }}</div>
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight">{{ about.experience.heading }}</h2>
            </div>
            <div class="font-mono text-xs text-rt-muted"><bdi>{{ about.experience.total | safe }}</bdi></div>
        </div>

        <div class="rt-tl">
            {% for item in about.experience.items %}
            <div data-reveal class="rt-tl-item relative {% if item.current %}is-current{% endif %} {% if not loop.last %}pb-9{% endif %}">
                <div class="flex items-baseline gap-x-3 gap-y-1 flex-wrap mb-1.5">
                    <span class="text-xl sm:text-2xl font-bold tracking-tight">{{ item.role }}</span>
                    <span class="text-sm text-rt-muted">في <b class="text-rt-text font-semibold"><bdi>{{ item.at }}</bdi></b></span>
                    {% if item.current %}<span class="font-mono text-[10px] uppercase tracking-wide text-rt-accent border border-rt-accent/40 bg-rt-accent/10 px-2 py-0.5 rounded-full">الحالي</span>{% endif %}
                </div>
                <div class="font-mono text-[11px] tracking-[0.04em] text-rt-muted mb-4"><bdi>{{ item.when }}</bdi></div>
                <ul class="grid md:grid-cols-2 gap-x-8 gap-y-3">
                    {% for b in item.bullets %}
                    <li class="rt-tl-bullet text-sm text-rt-muted leading-relaxed">{% if b.metric %}<span class="text-rt-accent font-semibold"><bdi>{{ b.metric }}</bdi></span> {% endif %}{{ b.text | safe }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- ───────── Certifications ───────── -->
<section id="certifications" class="border-t border-rt-border bg-rt-subtle">
    <div class="max-w-7xl mx-auto px-6 py-16 lg:py-20">
        <div data-reveal class="mb-8 lg:mb-10">
            <div class="font-mono text-xs uppercase tracking-[0.1em] text-rt-muted mb-2">{{ about.certifications.eyebrow }}</div>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight">{{ about.certifications.heading }}</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for cert in about.certifications.items %}
            <div data-reveal class="rt-card border border-rt-border rounded-xl bg-rt-surface p-5 transition-all duration-300">
                <div class="font-mono text-[10px] uppercase tracking-[0.12em] text-rt-accent mb-2">{{ cert.by }}</div>
                <h3 class="text-[15px] font-semibold leading-snug mb-2">{{ cert.name }}</h3>
                <p class="text-[13px] text-rt-muted leading-relaxed">{{ cert.note | safe }}</p>
                <span class="block font-mono text-[11px] text-rt-muted mt-3"><bdi>{{ cert.year }}</bdi></span>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
