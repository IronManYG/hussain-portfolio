---
layout: ar_base.njk
title: "حسين قدال | مطور تطبيقات أندرويد أول"
description: "حسين قدال — مطور تطبيقات أندرويد أول بخبرة 4+ سنوات في بناء تطبيقات Kotlin و Jetpack Compose القابلة للتوسع. خبير في Clean Architecture و Kotlin Multiplatform وتطوير الخوادم."
---
<!-- Hero Section -->
    <header class="relative pt-24 sm:pt-32 lg:pt-40 pb-20 px-4 sm:px-6 max-w-7xl mx-auto min-h-[100svh] sm:min-h-[90vh] flex flex-col justify-center">
        <div class="particles-bg" id="particles-container"></div>
        <div class="relative z-10 grid lg:grid-cols-2 gap-12 items-center">
            <div class="max-w-3xl">
                <div
                    class="inline-flex items-center space-x-2 px-3 py-1 rounded-full border border-ide-border bg-ide-surface text-xs font-mono text-ide-text-muted mb-6 hero-animate hero-badge-anime shadow-sm">
                    <span class="available-dot w-2 h-2 rounded-full bg-green-500" aria-hidden="true"></span>
                    <span>{{ home.ar.hero.badge }}</span>
                </div>

                <h1 class="mb-6">
                    <span class="block text-xl md:text-2xl text-ide-text-strong font-semibold mb-2 hero-animate hero-sub-anime">{{ home.ar.hero.greeting }}</span>
                    <span class="block text-5xl md:text-7xl font-bold leading-tight hero-animate hero-headline">{{ home.ar.hero.headline | safe }}</span>
                </h1>

                <p class="text-xl md:text-2xl text-ide-text-muted mb-10 leading-relaxed font-light hero-animate hero-sub-anime">
                    {{ home.ar.hero.subtitle }}
                </p>

                <div class="flex flex-col sm:flex-row sm:items-center gap-4 hero-animate hero-ctas-anime">
                    <div class="magnetic-wrap">
                        <a href="#projects" class="btn-primary shadow-kotlin-glow mt-0">
                            {{ home.ar.hero.btn_work }} <i class="ph ph-arrow-left ml-2 text-lg"></i>
                        </a>
                    </div>
                    <div class="magnetic-wrap">
                        <a href="{{ '/cv/Hussain_Gaddal_CV.pdf' | url }}" target="_blank" rel="noopener noreferrer" class="btn-secondary mt-0">
                            <i class="ph ph-file-pdf mr-2 text-lg"></i> {{ home.ar.hero.btn_cv }}
                        </a>
                    </div>
                    <div class="magnetic-wrap">
                        <a href="mailto:hussain.yg2010@gmail.com" class="btn-secondary mt-0">
                            {{ home.ar.hero.btn_contact }}
                        </a>
                    </div>
                </div>
            </div>

            <!-- Profile Picture -->
            <div class="hidden lg:flex justify-center items-center hero-animate animate-float">
                <div class="hero-avatar-container">
                    <img src="../assets/img/new-hussain.jpg" alt="حسين قدال - مطور تطبيقات أندرويد أول في الرياض" class="hero-avatar">
                </div>
            </div>
        </div>
    </header>


    <!-- About Section -->
    <section id="about" class="py-24 px-4 sm:px-6 border-t border-ide-border bg-gradient-to-b from-ide-bg to-ide-bg-darker overflow-hidden">
        <div class="max-w-7xl mx-auto grid md:grid-cols-2 gap-12 md:gap-16 items-center">
            <div class="fade-section min-w-0">
                <h2 class="text-sm uppercase tracking-widest text-ide-text-muted font-semibold mb-3">{{ home.ar.about.section_label }}</h2>
                <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-6">{{ home.ar.about.title | safe }}</h3>
                <div class="space-y-4 text-ide-text-muted leading-relaxed break-words overflow-wrap-anywhere">
                    {% for p in home.ar.about.paragraphs %}
                    <p>{{ p | safe }}</p>
                    {% endfor %}
                </div>
            </div>
            <div class="fade-section code-block-anime relative min-w-0" dir="ltr">
                <!-- Abstract Code Decoration -->
                <div
                    class="absolute -inset-4 bg-gradient-to-tr from-kotlin-purple/20 to-transparent blur-3xl rounded-full pointer-events-none">
                </div>
                <div
                    class="relative bg-ide-surface border border-ide-border rounded-2xl p-3 sm:p-6 font-mono text-xs sm:text-sm overflow-hidden shadow-2xl">
                    <div class="flex space-x-2 mb-4">
                        <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                        <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                        <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                    </div>
                    <pre lang="en" class="text-ide-text-muted overflow-x-auto"><code class="language-kotlin"><span class="text-kotlin-orange">class</span> <span class="text-kotlin-purple">HussainGaddal</span> : <span class="text-ide-text-strong">SeniorAndroidDeveloper</span>() {
    <span class="text-kotlin-orange">val</span> <span class="text-[#79C0FF]">location</span> = <span class="text-[#A5D6FF]">"Riyadh, SA"</span>
    <span class="text-kotlin-orange">val</span> <span class="text-[#79C0FF]">experience</span> = <span class="text-[#A5D6FF]">4</span>

    <span class="text-kotlin-orange">fun</span> <span class="text-[#D2A8FF]">techStack</span>() = listOf(
        <span class="text-[#A5D6FF]">"Kotlin"</span>, 
        <span class="text-[#A5D6FF]">"Jetpack Compose"</span>,
        <span class="text-[#A5D6FF]">"Kotlin Multiplatform"</span>,
        <span class="text-[#A5D6FF]">"Clean Architecture"</span>
    )

    <span class="text-kotlin-orange">fun</span> <span class="text-[#D2A8FF]">buildFeatures</span>() {
        <span class="text-ide-text-muted">/* Deploy robust systems */</span>
    }
}</code></pre>
                </div>
            </div>
        </div>
    </section>

    <!-- Projects (Bento Box Grid) -->
    <section id="projects" class="py-24 px-4 sm:px-6 max-w-7xl mx-auto">
        <div class="flex justify-between items-end mb-12">
            <div>
                <h2 class="text-sm uppercase tracking-widest text-ide-text-muted font-semibold mb-3">{{ home.ar.featured_projects.section_label }}</h2>
                <h3 class="text-3xl md:text-4xl font-bold">{{ home.ar.featured_projects.title }}</h3>
            </div>
            <a href="{{ '/ar/projects/' | url }}" class="hidden sm:inline-flex items-center text-sm font-semibold text-kotlin-purple hover:text-kotlin-purple/80 transition-colors">
                {{ locales.ar.nav_all_projects }} <i class="ph ph-arrow-left mr-2"></i>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bento-grid-anime">
            {% for project in projects %}
            {% if project.featured %}
            <a href="{{ ('/ar/' + project.slug + '/') | url }}" class="bento-card group flex flex-col overflow-hidden bento-animate {{ project.grid.glow }}">
                <div class="relative aspect-video overflow-hidden bg-ide-bg-darker">
                    {% if project.grid.images %}
                    <img src="{{ project.grid.images.ar.light | url }}" alt="{{ project.title_ar }} Hero" loading="lazy" decoding="async" class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03] dark:hidden">
                    <img src="{{ project.grid.images.ar.dark | url }}" alt="{{ project.title_ar }} Hero" loading="lazy" decoding="async" class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03] hidden dark:block">
                    {% elif project.grid.image %}
                    <img src="{{ project.grid.image | url }}" alt="{{ project.title_ar }} Hero" loading="lazy" decoding="async" class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03]">
                    {% elif project.grid.icon %}
                    <div class="w-full h-full flex items-center justify-center bg-ide-surface-hover">
                        <i class="ph {{ project.grid.icon }} text-7xl {{ project.grid.iconColor }} opacity-50 transition-transform duration-500 group-hover:scale-110"></i>
                    </div>
                    {% endif %}
                </div>

                <div class="p-6 flex-1 flex flex-col">
                    <div class="flex gap-2 mb-3 max-w-full overflow-hidden flex-wrap">
                        {% for tag in project.tags.slice(0, 3) %}
                        <span class="tech-pill">{{ tag }}</span>
                        {% endfor %}
                    </div>
                    <h4 class="text-2xl font-bold mb-2 group-hover:text-ide-text-strong transition-colors">{{ project.title_ar }}
                        <i class="ph ph-arrow-up-right inline-block opacity-0 group-hover:opacity-100 transition-opacity transform scale-x-[-1]"></i>
                    </h4>
                    <p class="text-ide-text-muted font-light">{{ project.description_ar }}</p>
                </div>
            </a>
            {% endif %}
            {% endfor %}
        </div>
        
        <div class="mt-12 text-center sm:hidden">
            <a href="{{ '/ar/projects/' | url }}" class="inline-flex items-center text-sm font-semibold text-kotlin-purple hover:text-kotlin-purple/80 transition-colors">
                {{ locales.ar.nav_all_projects }} <i class="ph ph-arrow-left mr-2"></i>
            </a>
        </div>
    </section>

    <!-- Expertise Section -->
    <section id="expertise" class="py-24 px-4 sm:px-6 border-t border-ide-border bg-gradient-to-b from-ide-bg-darker to-ide-bg">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-16 fade-section">
                <h2 class="text-sm uppercase tracking-widest text-ide-text-muted font-semibold mb-3">{{ home.ar.expertise.section_label }}</h2>
                <h3 class="text-3xl md:text-4xl font-bold">{{ home.ar.expertise.title }}</h3>
            </div>

            <div class="fade-section">
                <!-- Expertise Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for item in home.ar.expertise.items %}
                    <div class="expertise-card expertise-card-anime p-8 rounded-2xl bg-ide-surface border border-ide-border group hover:border-kotlin-purple/50 transition-all duration-300 {{ item.gridCols }}">
                        <div class="w-12 h-12 rounded-xl {{ item.bgLight }} flex items-center justify-center mb-6 {{ item.bgHover }} transition-colors expertise-icon-anime">
                            <i class="ph {{ item.icon }} text-2xl {{ item.color }}"></i>
                        </div>
                        <h4 class="text-xl font-bold mb-3 expertise-title-anime">{{ item.title }}</h4>
                        <p class="text-ide-text-muted text-sm leading-relaxed mb-4 expertise-body-anime">{{ item.description | safe }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>