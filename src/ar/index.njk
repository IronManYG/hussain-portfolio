---
layout: base_rt_ar.njk
title: "حسين قدال | مطور تطبيقات أندرويد"
description: "حسين قدال، مطوّر أندرويد بخبرة تتجاوز ٤ سنوات في بناء تطبيقات Kotlin و Jetpack Compose. يعمل بالمعمارية النظيفة و KMP/CMP وخوادم Kotlin."
---
<!-- ───────── البطل (Hero) ───────── -->
<header class="relative max-w-7xl mx-auto px-6 pt-32 pb-16 lg:pt-40 lg:pb-24">
    <div class="relative z-[1] grid lg:grid-cols-[1.4fr_1fr] gap-12 lg:gap-16 items-center">
        <!-- النص -->
        <div>
            <div data-hero style="--hero-step:0" class="inline-flex items-center gap-2 font-mono text-xs text-rt-muted border border-rt-border bg-rt-surface px-3 py-1.5 rounded-full mb-6">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                {{ home.ar.hero.badge }}
            </div>
            <p data-hero style="--hero-step:1" class="font-mono text-sm text-rt-muted mb-4">{{ home.ar.hero.greeting }}</p>
            <h1 data-hero style="--hero-step:2" class="rt-em text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-tight mb-6">{{ home.ar.hero.headline | safe }}</h1>
            <p data-hero style="--hero-step:3" class="text-lg text-rt-muted leading-relaxed max-w-xl mb-8">{{ home.ar.hero.subtitle | safe }}</p>
            <div data-hero style="--hero-step:4" class="flex flex-wrap items-center gap-3">
                <a href="#projects" class="inline-flex items-center gap-2 bg-rt-accent text-rt-btn-text font-semibold px-5 py-3 rounded-[10px] hover:brightness-110 hover:-translate-y-0.5 transition-all">
                    {{ home.ar.hero.btn_work }} <span class="font-mono">←</span>
                </a>
                <a href="{{ '/cv/Hussain_Gaddal_CV.pdf' | url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-rt-border text-rt-text font-medium px-5 py-3 rounded-[10px] hover:border-rt-accent transition-colors">
                    <i class="ph ph-file-pdf"></i> {{ home.ar.hero.btn_cv }}
                </a>
            </div>
        </div>

        <!-- بطاقة الصورة + الأرقام -->
        <div data-hero style="--hero-step:5" class="rt-card border border-rt-border rounded-2xl overflow-hidden bg-rt-surface transition-all duration-300">
            <img src="{{ '/assets/img/hussain-portrait.webp' | url }}" alt="حسين قدال — مطور تطبيقات أندرويد في الرياض"
                 width="2400" height="1600" fetchpriority="high"
                 class="w-full aspect-[4/5] object-cover" style="object-position: 28% 20%;">
            <div class="grid grid-cols-3 border-t border-rt-border">
                {% for s in home.ar.hero.stats %}
                <div class="px-4 py-3.5 {% if not loop.last %}border-e border-rt-border{% endif %}">
                    <div class="text-xl font-bold leading-none"><bdi{% if s.n %} data-countup="{{ s.n }}" data-countup-suffix="{{ s.suffix | default('') }}"{% endif %}>{{ s.v }}</bdi></div>
                    <div class="font-mono text-[10px] uppercase tracking-wide text-rt-muted mt-1">{{ s.k }}</div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</header>

<!-- ───────── شريط الحقائق ───────── -->
<section class="border-y border-rt-border bg-rt-subtle">
    <div class="max-w-7xl mx-auto px-6 flex flex-wrap">
        {% for f in home.ar.facts %}
        <div data-reveal class="flex-1 min-w-[50%] sm:min-w-0 px-5 py-5 {% if not loop.last %}sm:border-e border-rt-border{% endif %}">
            <div class="font-mono text-[10px] uppercase tracking-[0.08em] text-rt-muted">{{ f.k }}</div>
            <div class="text-[15px] text-rt-text mt-1.5"><bdi>{{ f.v }}</bdi></div>
        </div>
        {% endfor %}
    </div>
</section>

<!-- ───────── نبذة ───────── -->
<section id="about" class="max-w-7xl mx-auto px-6 py-20 lg:py-24">
    <div class="grid lg:grid-cols-[1fr_1.25fr] gap-10 lg:gap-16 items-start">
        <div data-reveal>
            <div class="font-mono text-xs uppercase tracking-[0.1em] text-rt-muted mb-3">{{ home.ar.about.section_label }}</div>
            <h2 class="rt-em text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight tracking-tight">{{ home.ar.about.title | safe }}</h2>
        </div>
        <div data-reveal>
            {% for p in home.ar.about.paragraphs.slice(0, 3) %}
            <p class="text-rt-muted leading-relaxed{% if not loop.last %} mb-4{% endif %}">{{ p | safe }}</p>
            {% endfor %}
            <a href="{{ '/ar/about/' | url }}" class="inline-flex items-center gap-2 text-sm text-rt-accent hover:brightness-110 transition mt-6">
                المزيد عنّي <span class="font-mono">←</span>
            </a>
        </div>
    </div>
</section>

<!-- ───────── الأعمال المختارة ───────── -->
<section id="projects" class="border-t border-rt-border max-w-7xl mx-auto px-6 py-20 lg:py-24">
    <div data-reveal class="flex items-end justify-between gap-6 mb-10">
        <div>
            <div class="font-mono text-xs uppercase tracking-[0.1em] text-rt-muted mb-2">{{ home.ar.featured_projects.section_label }}</div>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight">مشاريع مميزة</h2>
        </div>
        <a href="{{ '/ar/projects/' | url }}" class="hidden sm:inline-flex items-center gap-2 text-sm text-rt-accent hover:brightness-110 transition">
            كافة المشاريع <span class="font-mono">←</span>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        {% for project in projects %}{% if project.featured %}
        {% if project.feature_card %}
        <!-- بطاقة مميزة (span-12) -->
        <a data-reveal href="{{ ('/ar/' + project.slug + '/') | url }}" class="rt-card group md:col-span-12 grid md:grid-cols-[1.4fr_1fr] border border-rt-border rounded-2xl overflow-hidden bg-rt-surface transition-all duration-300">
            <div class="relative aspect-video overflow-hidden bg-rt-subtle">
                {% if project.grid.images %}
                <img src="{{ project.grid.images.ar.light | url }}" alt="{{ project.title_ar }}" loading="lazy" decoding="async" class="rt-thumb absolute inset-0 w-full h-full object-cover opacity-100 dark:opacity-0">
                <img src="{{ project.grid.images.ar.dark | url }}" alt="{{ project.title_ar }}" loading="lazy" decoding="async" class="rt-thumb absolute inset-0 w-full h-full object-cover opacity-0 dark:opacity-100">
                {% endif %}
            </div>
            <div class="p-6 sm:p-8 flex flex-col justify-center">
                <div class="flex flex-wrap gap-2 mb-3 font-mono">
                    {% for tag in project.tags.slice(0, 3) %}<span class="text-[10px] px-2 py-0.5 rounded-full bg-rt-subtle text-rt-muted border border-rt-border" dir="ltr">{{ tag }}</span>{% endfor %}
                </div>
                <h3 class="text-2xl font-bold tracking-tight mb-2 group-hover:text-rt-accent transition-colors">{{ project.title_ar }}{% if project.year %} <span class="text-rt-muted font-normal text-lg">· <bdi>{{ project.year | arNum }}</bdi></span>{% endif %}</h3>
                <p class="text-rt-muted leading-relaxed{% if project.card_impact_ar %} mb-5{% endif %}">{{ project.description_ar }}</p>
                {% if project.card_impact_ar %}
                <div class="pt-4 border-t border-rt-border">
                    <span class="font-mono text-sm text-rt-accent">{{ project.card_impact_ar }}</span>
                </div>
                {% endif %}
            </div>
        </a>
        {% else %}
        <!-- بطاقة قياسية (span-4) -->
        <a data-reveal href="{{ ('/ar/' + project.slug + '/') | url }}" class="rt-card group md:col-span-4 flex flex-col border border-rt-border rounded-2xl overflow-hidden bg-rt-surface transition-all duration-300">
            <div class="relative aspect-video overflow-hidden bg-rt-subtle">
                {% if project.grid.images %}
                <img src="{{ project.grid.images.ar.light | url }}" alt="{{ project.title_ar }}" loading="lazy" decoding="async" class="rt-thumb absolute inset-0 w-full h-full object-cover opacity-100 dark:opacity-0">
                <img src="{{ project.grid.images.ar.dark | url }}" alt="{{ project.title_ar }}" loading="lazy" decoding="async" class="rt-thumb absolute inset-0 w-full h-full object-cover opacity-0 dark:opacity-100">
                {% endif %}
            </div>
            <div class="p-5 flex flex-col flex-1">
                <div class="flex flex-wrap gap-2 mb-3 font-mono">
                    {% for tag in project.tags.slice(0, 2) %}<span class="text-[10px] px-2 py-0.5 rounded-full bg-rt-subtle text-rt-muted border border-rt-border" dir="ltr">{{ tag }}</span>{% endfor %}
                </div>
                <h3 class="text-lg font-bold tracking-tight mb-1.5 group-hover:text-rt-accent transition-colors">{{ project.title_ar }}{% if project.year %} <span class="text-rt-muted font-normal text-sm">· <bdi>{{ project.year | arNum }}</bdi></span>{% endif %}</h3>
                <p class="text-sm text-rt-muted leading-relaxed mb-4">{{ project.description_ar }}</p>
                {% if project.card_impact_ar %}
                <div class="mt-auto pt-3 border-t border-rt-border">
                    <span class="font-mono text-xs text-rt-accent">{{ project.card_impact_ar }}</span>
                </div>
                {% endif %}
            </div>
        </a>
        {% endif %}
        {% endif %}{% endfor %}
    </div>

    <div class="mt-10 text-center sm:hidden">
        <a href="{{ '/ar/projects/' | url }}" class="inline-flex items-center gap-2 text-sm text-rt-accent">كافة المشاريع <span class="font-mono">←</span></a>
    </div>
</section>

<!-- ───────── المهارات ───────── -->
<section id="expertise" class="border-t border-rt-border">
    <div class="max-w-7xl mx-auto px-6 py-20 lg:py-24">
        <div data-reveal class="mb-10">
            <div class="font-mono text-xs uppercase tracking-[0.1em] text-rt-muted mb-2">{{ home.ar.expertise.section_label }}</div>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight">{{ home.ar.expertise.title }}</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {% for item in home.ar.expertise.items %}
            <div data-reveal class="border border-rt-border rounded-2xl bg-rt-surface p-6">
                <div class="w-11 h-11 rounded-xl bg-rt-accent/10 text-rt-accent flex items-center justify-center mb-4">
                    <i class="ph {{ item.icon }} text-xl" aria-hidden="true"></i>
                </div>
                <h3 class="text-lg font-bold tracking-tight mb-2">{{ item.title }}</h3>
                <p class="text-sm text-rt-muted leading-relaxed">{{ item.description | safe }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
