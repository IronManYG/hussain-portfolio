---
layout: base_rt_ar.njk
backTo: projects
pagination:
  data: projects
  size: 1
  alias: project
permalink: "ar/{{ project.slug }}/index.html"
eleventyComputed:
  title: "{{ project.title_ar }} | حسين قدال — مطور تطبيقات أندرويد"
  seo_description: "{{ project.description_ar }}"
  repoUrl: "{{ project.repoUrl }}"
---
{% set nonTech = ["Course Challenge", "Course Project", "Community Challenge", "Personal", "Personal Project", "Professional", "Institution"] %}

<article class="max-w-4xl mx-auto px-6 pt-32 pb-20 lg:pt-40">
    <!-- Breadcrumb -->
    <nav aria-label="مسار التنقل" class="font-mono text-xs text-rt-muted mb-8">
        <a href="{{ '/ar/projects/' | url }}" class="hover:text-rt-accent transition-colors">{{ locales.ar.breadcrumb_projects }}</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span aria-current="page" class="text-rt-text">{{ project.title_ar }}</span>
    </nav>

    <!-- Hero -->
    <header class="mb-10">
        <div class="flex flex-wrap gap-2 mb-5 font-mono">
            {% for tag in project.tags %}<span class="text-[11px] px-2.5 py-1 rounded-full bg-rt-subtle text-rt-muted border border-rt-border">{{ tag }}</span>{% endfor %}
        </div>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-5">{{ project.title_ar }}</h1>
        <p class="text-lg sm:text-xl text-rt-muted leading-relaxed max-w-3xl">{{ project.description_ar }}</p>

        <!-- Meta strip — only rows that exist -->
        {% set typeTag = null %}{% for tag in project.tags %}{% if tag in nonTech and not typeTag %}{% set typeTag = tag %}{% endif %}{% endfor %}
        <dl class="flex flex-wrap gap-x-10 gap-y-4 mt-8 pt-6 border-t border-rt-border">
            {% if project.year %}<div><dt class="font-mono text-[10px] uppercase tracking-[0.1em] text-rt-muted">السنة</dt><dd class="text-sm text-rt-text mt-1"><bdi>{{ project.year | arNum }}</bdi></dd></div>{% endif %}
            {% if typeTag %}<div><dt class="font-mono text-[10px] uppercase tracking-[0.1em] text-rt-muted">النوع</dt><dd class="text-sm text-rt-text mt-1">{{ typeTag }}</dd></div>{% endif %}
        </dl>
    </header>

    <!-- Hero visual -->
    {% if project.grid.images %}
    <div class="mb-12 rounded-2xl overflow-hidden border border-rt-border bg-rt-subtle">
        <img src="{{ project.grid.images.ar.light | url }}" alt="{{ project.title_ar }}" decoding="async" class="w-full h-auto object-contain dark:hidden">
        <img src="{{ project.grid.images.ar.dark | url }}" alt="{{ project.title_ar }}" decoding="async" class="w-full h-auto object-contain hidden dark:block">
    </div>
    {% elif project.grid.image %}
    <div class="mb-12 rounded-2xl overflow-hidden border border-rt-border bg-rt-subtle">
        <img src="{{ project.grid.image | url }}" alt="{{ project.title_ar }}" decoding="async" class="w-full h-auto object-contain">
    </div>
    {% elif project.grid.icon %}
    <div class="mb-12 rounded-2xl h-72 border border-rt-border bg-rt-subtle flex items-center justify-center">
        <i class="ph {{ project.grid.icon }} text-8xl text-rt-accent" aria-hidden="true"></i>
    </div>
    {% endif %}

    <!-- Impact stat strip (only if present) -->
    {% if project.featured_stats_ar %}
    <div class="grid grid-cols-3 border border-rt-border rounded-xl bg-rt-surface mb-12 overflow-hidden">
        {% for s in project.featured_stats_ar %}
        <div class="px-5 py-5 {% if not loop.first %}border-r border-rt-border{% endif %}">
            <div class="text-2xl sm:text-3xl font-bold tracking-tight leading-none"><bdi>{{ s.v }}</bdi></div>
            <div class="font-mono text-[10px] uppercase tracking-wide text-rt-muted mt-2">{{ s.k }}</div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    <!-- Overview -->
    {% if project.overview_ar %}
    <section data-reveal class="mb-12">
        <h2 class="text-2xl font-bold tracking-tight mb-5">{{ locales.ar.project_overview }}</h2>
        <div class="rt-prose max-w-none">{{ project.overview_ar | safe }}</div>
    </section>
    {% endif %}

    <!-- Challenge -->
    {% if project.challenge_ar %}
    <section data-reveal class="mb-12 border-s-2 border-rt-accent bg-rt-surface rounded-e-xl rounded-s-sm p-6 sm:p-8">
        <h2 class="text-2xl font-bold tracking-tight mb-4">{{ locales.ar.project_challenge }}</h2>
        <div class="rt-prose max-w-none">{{ project.challenge_ar | safe }}</div>
    </section>
    {% endif %}

    <!-- Architecture -->
    {% if project.architecture_ar %}
    <section data-reveal class="mb-12">
        <h2 class="text-2xl font-bold tracking-tight mb-5">{{ locales.ar.project_architecture }}</h2>
        <div class="rt-prose max-w-none">{{ project.architecture_ar | safe }}</div>
    </section>
    {% endif %}

    <!-- Impact -->
    {% if project.impact_ar %}
    <section data-reveal class="mb-12 bg-rt-subtle border border-rt-border rounded-xl p-6 sm:p-8">
        <h2 class="text-2xl font-bold tracking-tight mb-4 flex items-center gap-2"><i class="ph ph-trophy text-rt-accent" aria-hidden="true"></i> {{ locales.ar.project_impact }}</h2>
        <div class="rt-prose max-w-none">{{ project.impact_ar | safe }}</div>
    </section>
    {% endif %}

    <!-- Tech stack -->
    {% if project.tech_stack and project.tech_stack.length > 0 %}
    <section data-reveal class="mb-12">
        <h2 class="text-2xl font-bold tracking-tight mb-5">{{ locales.ar.project_tech_stack }}</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            {% for tech in project.tech_stack %}
            <div class="rt-card border border-rt-border rounded-lg bg-rt-surface p-4 transition-all duration-300">
                <span class="block font-mono text-[10px] uppercase tracking-[0.08em] text-rt-muted mb-1">{{ tech.label }}</span>
                <span class="text-sm font-semibold text-rt-text">{{ tech.value }}</span>
            </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <!-- Repo CTA -->
    {% if project.repoUrl %}
    <div class="mb-4">
        <a href="{{ project.repoUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-rt-border text-rt-text font-medium px-5 py-3 rounded-[10px] hover:border-rt-accent transition-colors">
            <i class="ph ph-github-logo"></i> اطّلع على الكود في GitHub
        </a>
    </div>
    {% endif %}

    <!-- Prev / Next -->
    {% set prevProject = projects[pagination.pageNumber - 1] %}
    {% set nextProject = projects[pagination.pageNumber + 1] %}
    <nav class="flex flex-col sm:flex-row gap-4 sm:gap-0 sm:justify-between mt-12 pt-8 border-t border-rt-border" aria-label="التنقل بين المشاريع">
        {% if prevProject %}
        <a href="{{ ('/ar/' + prevProject.slug + '/') | url }}" class="group flex items-start gap-3 text-right max-w-sm" rel="prev">
            <span class="font-mono mt-0.5 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            <span>
                <span class="block font-mono text-[10px] uppercase tracking-wider text-rt-muted">{{ locales.ar.nav_prev_project }}</span>
                <span class="block text-base font-semibold group-hover:text-rt-accent transition-colors">{{ prevProject.title_ar }}</span>
            </span>
        </a>
        {% else %}<span></span>{% endif %}
        {% if nextProject %}
        <a href="{{ ('/ar/' + nextProject.slug + '/') | url }}" class="group flex items-start gap-3 text-left max-w-sm" rel="next">
            <span>
                <span class="block font-mono text-[10px] uppercase tracking-wider text-rt-muted">{{ locales.ar.nav_next_project }}</span>
                <span class="block text-base font-semibold group-hover:text-rt-accent transition-colors">{{ nextProject.title_ar }}</span>
            </span>
            <span class="font-mono mt-0.5 transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
        </a>
        {% endif %}
    </nav>
</article>
