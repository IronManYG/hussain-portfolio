---
layout: base_rt.njk
title: "Hussain Gaddal | Android Developer"
description: "Hussain Gaddal, Android Developer with 4+ years building Kotlin and Jetpack Compose apps. Works in Clean Architecture, KMP/CMP, and backend Kotlin."
---
<!-- ───────── Hero ───────── -->
<header class="relative max-w-7xl mx-auto px-6 pt-32 pb-16 lg:pt-40 lg:pb-24 overflow-hidden">
    <div class="absolute pointer-events-none" aria-hidden="true"
         style="width:480px;height:480px;top:-160px;right:-120px;background:radial-gradient(circle, rgb(var(--rt-accent) / 0.28), transparent 65%);filter:blur(20px);"></div>
    <div class="relative z-[1] grid lg:grid-cols-[1.4fr_1fr] gap-12 lg:gap-16 items-center">
        <!-- Copy -->
        <div>
            <div class="inline-flex items-center gap-2 font-mono text-xs text-rt-muted border border-rt-border bg-rt-surface px-3 py-1.5 rounded-full mb-6">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                {{ home.en.hero.badge }}
            </div>
            <p class="font-mono text-sm text-rt-muted mb-4">{{ home.en.hero.greeting }}</p>
            <h1 class="rt-em text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-tight mb-6">{{ home.en.hero.headline | safe }}</h1>
            <p class="text-lg text-rt-muted leading-relaxed max-w-xl mb-8">{{ home.en.hero.subtitle | safe }}</p>
            <div class="flex flex-wrap items-center gap-3">
                <a href="#projects" class="inline-flex items-center gap-2 bg-rt-accent text-rt-btn-text font-semibold px-5 py-3 rounded-[10px] hover:brightness-110 hover:-translate-y-0.5 transition-all">
                    {{ home.en.hero.btn_work }} <span class="font-mono">→</span>
                </a>
                <a href="{{ '/cv/Hussain_Gaddal_CV.pdf' | url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-rt-border text-rt-text font-medium px-5 py-3 rounded-[10px] hover:border-rt-accent transition-colors">
                    <i class="ph ph-file-pdf"></i> {{ home.en.hero.btn_cv }}
                </a>
            </div>
        </div>

        <!-- Portrait card + stats -->
        <div class="rt-card border border-rt-border rounded-2xl overflow-hidden bg-rt-surface transition-all duration-300">
            <img src="{{ '/assets/img/new-hussain.jpg' | url }}" alt="Hussain Gaddal — Android Developer in Riyadh"
                 class="w-full aspect-[4/5] object-cover" style="object-position: 28% 20%;">
            <div class="grid grid-cols-3 border-t border-rt-border">
                {% for s in home.en.hero.stats %}
                <div class="px-4 py-3.5 {% if not loop.last %}border-r border-rt-border{% endif %}">
                    <div class="text-xl font-bold leading-none">{{ s.v }}</div>
                    <div class="font-mono text-[10px] uppercase tracking-wide text-rt-muted mt-1">{{ s.k }}</div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</header>

<!-- ───────── Facts strip ───────── -->
<section class="border-y border-rt-border bg-rt-subtle">
    <div class="max-w-7xl mx-auto px-6 flex flex-wrap">
        {% for f in home.en.facts %}
        <div class="flex-1 min-w-[50%] sm:min-w-0 px-5 py-5 {% if not loop.last %}sm:border-r border-rt-border{% endif %}">
            <div class="font-mono text-[10px] uppercase tracking-[0.08em] text-rt-muted">{{ f.k }}</div>
            <div class="text-[15px] text-rt-text mt-1.5">{{ f.v }}</div>
        </div>
        {% endfor %}
    </div>
</section>

<!-- ───────── Selected work ───────── -->
<section id="projects" class="max-w-7xl mx-auto px-6 py-20 lg:py-24">
    <div class="flex items-end justify-between gap-6 mb-10">
        <div>
            <div class="font-mono text-xs uppercase tracking-[0.1em] text-rt-muted mb-2">{{ home.en.featured_projects.section_label }}</div>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight">Work that shipped.</h2>
        </div>
        <a href="{{ '/projects/' | url }}" class="hidden sm:inline-flex items-center gap-2 text-sm text-rt-accent hover:brightness-110 transition">
            All projects <span class="font-mono">→</span>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        {% for project in projects %}{% if project.featured %}
        {% if project.feature_card %}
        <!-- Feature card (span-12, 2-col, whole thumbnail visible) -->
        <a href="{{ ('/' + project.slug + '/') | url }}" class="rt-card group md:col-span-12 grid md:grid-cols-[1.4fr_1fr] border border-rt-border rounded-2xl overflow-hidden bg-rt-surface transition-all duration-300">
            <div class="relative aspect-video overflow-hidden bg-rt-subtle">
                {% if project.grid.images %}
                <img src="{{ project.grid.images.en.light | url }}" alt="{{ project.title_en }}" loading="lazy" decoding="async" class="rt-thumb absolute inset-0 w-full h-full object-cover opacity-100 dark:opacity-0">
                <img src="{{ project.grid.images.en.dark | url }}" alt="{{ project.title_en }}" loading="lazy" decoding="async" class="rt-thumb absolute inset-0 w-full h-full object-cover opacity-0 dark:opacity-100">
                {% endif %}
            </div>
            <div class="p-6 sm:p-8 flex flex-col justify-center">
                <div class="flex flex-wrap gap-2 mb-3 font-mono">
                    {% for tag in project.tags.slice(0, 3) %}<span class="text-[10px] px-2 py-0.5 rounded-full bg-rt-subtle text-rt-muted border border-rt-border">{{ tag }}</span>{% endfor %}
                </div>
                <h3 class="text-2xl font-bold tracking-tight mb-2 group-hover:text-rt-accent transition-colors">{{ project.title_en }}{% if project.year %} <span class="text-rt-muted font-normal text-lg">· {{ project.year }}</span>{% endif %}</h3>
                <p class="text-rt-muted leading-relaxed{% if project.card_impact_en %} mb-5{% endif %}">{{ project.description_en }}</p>
                {% if project.card_impact_en %}
                <div class="pt-4 border-t border-rt-border">
                    <span class="font-mono text-sm text-rt-accent">{{ project.card_impact_en }}</span>
                </div>
                {% endif %}
            </div>
        </a>
        {% else %}
        <!-- Standard card (span-4) -->
        <a href="{{ ('/' + project.slug + '/') | url }}" class="rt-card group md:col-span-4 flex flex-col border border-rt-border rounded-2xl overflow-hidden bg-rt-surface transition-all duration-300">
            <div class="relative aspect-video overflow-hidden bg-rt-subtle">
                {% if project.grid.images %}
                <img src="{{ project.grid.images.en.light | url }}" alt="{{ project.title_en }}" loading="lazy" decoding="async" class="rt-thumb absolute inset-0 w-full h-full object-cover opacity-100 dark:opacity-0">
                <img src="{{ project.grid.images.en.dark | url }}" alt="{{ project.title_en }}" loading="lazy" decoding="async" class="rt-thumb absolute inset-0 w-full h-full object-cover opacity-0 dark:opacity-100">
                {% endif %}
            </div>
            <div class="p-5 flex flex-col flex-1">
                <div class="flex flex-wrap gap-2 mb-3 font-mono">
                    {% for tag in project.tags.slice(0, 2) %}<span class="text-[10px] px-2 py-0.5 rounded-full bg-rt-subtle text-rt-muted border border-rt-border">{{ tag }}</span>{% endfor %}
                </div>
                <h3 class="text-lg font-bold tracking-tight mb-1.5 group-hover:text-rt-accent transition-colors">{{ project.title_en }}{% if project.year %} <span class="text-rt-muted font-normal text-sm">· {{ project.year }}</span>{% endif %}</h3>
                <p class="text-sm text-rt-muted leading-relaxed mb-4">{{ project.description_en }}</p>
                {% if project.card_impact_en %}
                <div class="mt-auto pt-3 border-t border-rt-border">
                    <span class="font-mono text-xs text-rt-accent">{{ project.card_impact_en }}</span>
                </div>
                {% endif %}
            </div>
        </a>
        {% endif %}
        {% endif %}{% endfor %}
    </div>

    <div class="mt-10 text-center sm:hidden">
        <a href="{{ '/projects/' | url }}" class="inline-flex items-center gap-2 text-sm text-rt-accent">All projects <span class="font-mono">→</span></a>
    </div>
</section>
