<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default("Hussain Gaddal | Android Developer & Kotlin Expert") }}</title>
    <meta name="description" content="{{ seo_description | default(description) | default('Hussain Gaddal — Android Developer based in Riyadh, working with Kotlin, Jetpack Compose, and KMP applications.') }}">
    <link rel="icon" type="image/svg+xml" href="{{ '/favicon.svg' | url }}">
    
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title | default('Hussain Gaddal | Android Developer & Kotlin Expert') }}">
    <meta property="og:description" content="{{ seo_description | default(description) | default('Hussain Gaddal — Android Developer based in Riyadh, working with Kotlin, Jetpack Compose, and KMP applications.') }}">
    <meta property="og:url" content="https://ironmanyg.github.io/hussain-portfolio{{ page.url | url }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta property="og:image" content="https://ironmanyg.github.io{{ '/assets/img/branding/og_image.png' | url }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:image" content="https://ironmanyg.github.io{{ '/assets/img/branding/og_image.png' | url }}">
    <meta name="twitter:title" content="{{ title | default('Hussain Gaddal | Android Developer & Kotlin Expert') }}">
    <meta name="twitter:description" content="{{ seo_description | default(description) | default('Hussain Gaddal — Android Developer based in Riyadh, working with Kotlin, Jetpack Compose, and KMP applications.') }}">
    
    <script>
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const useDark = savedTheme ? savedTheme === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', useDark);
    </script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link rel="stylesheet" href="{{ '/styles.css' | url }}">

    <link rel="manifest" href="{{ '/manifest.json' | url }}">
    <meta name="theme-color" content="#0D1117">
</head>
<body class="bg-ide-bg text-ide-text-main antialiased selection:bg-kotlin-purple/30 selection:text-ide-text-strong">

    <!-- Navbar -->
    <nav class="fixed w-full z-50 top-0 border-b border-ide-border bg-ide-bg/80 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            {% if page.url == '/' %}
            <a href="{{ '/' | url }}" class="text-xl font-bold font-mono tracking-tighter hover:text-kotlin-purple transition-colors">
                <span class="text-kotlin-orange">&lt;</span>HG<span class="text-kotlin-orange">/&gt;</span>
            </a>
            <div class="hidden md:flex items-center gap-6 text-sm font-medium text-ide-text-muted">
                <a href="#about" class="nav-link hover:text-ide-text-strong transition-colors">{{ locales.en.nav_about }}</a>
                <a href="#projects" class="nav-link hover:text-ide-text-strong transition-colors">{{ locales.en.nav_projects }}</a>
                <a href="#expertise" class="nav-link hover:text-ide-text-strong transition-colors">{{ locales.en.nav_expertise }}</a>
                <a href="#contact" class="nav-link hover:text-ide-text-strong transition-colors">{{ locales.en.nav_contact }}</a>
                <span class="h-4 w-px bg-ide-border" aria-hidden="true"></span>
                <a href="{{ '/about/' | url }}" class="nav-link inline-flex items-center gap-1 hover:text-ide-text-strong transition-colors">{{ locales.en.nav_experience }}<i class="ph ph-arrow-up-right text-xs"></i></a>
            </div>
            {% else %}
            <a href="{{ '/' | url }}" id="nav-back-btn" class="flex items-center gap-2 text-ide-text-muted hover:text-ide-text-strong transition-colors">
                <i class="ph ph-arrow-left"></i> <span id="nav-back-text">{{ locales.en.back_portfolio }}</span>
            </a>
            <script>
                (function() {
                    const ref = document.referrer;
                    const btn = document.getElementById('nav-back-btn');
                    const btnText = document.getElementById('nav-back-text');
                    if (!ref || !btn || !btnText) return;

                    let refUrl;
                    try { refUrl = new URL(ref); } catch(e) { return; }
                    if (refUrl.host !== window.location.host) return;

                    // Skip language-toggle round-trips so Back doesn't bounce
                    // the user back to the same page in the other locale.
                    const normalizePath = (p) => p.replace(/\/ar(\/|$)/, '/').replace(/\/+$/, '') || '/';
                    if (normalizePath(window.location.pathname) === normalizePath(refUrl.pathname)) return;

                    const refPath = refUrl.pathname.replace(/\/+$/, '');
                    btnText.textContent = /\/projects$/.test(refPath)
                        ? '{{ locales.en.back_projects }}'
                        : '{{ locales.en.back_portfolio }}';

                    // Set href as a fallback for cases where history.back()
                    // can't navigate (e.g., page opened in a new tab).
                    btn.href = ref;
                    btn.addEventListener('click', function(e) {
                        if (window.history.length > 1) {
                            e.preventDefault();
                            window.history.back();
                        }
                    });
                })();
            </script>
            {% endif %}
            
            <div class="flex items-center gap-4 text-ide-text-muted">
                {% if repoUrl %}
                <a href="{{ repoUrl }}" target="_blank" rel="noopener noreferrer" class="btn-primary text-sm px-4 py-2 flex items-center">
                    <i class="ph ph-github-logo mr-1.5 text-lg"></i> {{ locales.en.btn_view_code }}
                </a>
                {% endif %}
                
                {% if page.url == '/' %}
                <a href="https://www.linkedin.com/in/hussaingaddal/" target="_blank" rel="noopener noreferrer" class="text-2xl hover:text-[#79C0FF] transition-colors hidden md:inline-block" aria-label="LinkedIn Profile">
                    <i class="ph ph-linkedin-logo"></i>
                </a>
                <a href="https://github.com/IronManYG" target="_blank" rel="noopener noreferrer" class="text-2xl hover:text-ide-text-strong transition-colors" aria-label="GitHub Profile">
                    <i class="ph ph-github-logo"></i>
                </a>
                {% endif %}

                <button id="theme-toggle" class="text-xl hover:text-ide-text-strong transition-colors p-1" aria-label="Toggle Dark Mode">
                    <i class="ph ph-moon" id="theme-icon"></i>
                </button>
                <a href="{{ '/ar' | url }}{{ page.url }}" id="lang-toggle" class="text-sm font-bold hover:text-ide-text-strong transition-colors border border-ide-border px-2 py-0.5 rounded" aria-label="Toggle Language Arabic/English">
                    ع
                </a>
                
                {% if page.url == '/' %}
                <button id="mobile-menu-btn" class="text-2xl hover:text-ide-text-strong transition-colors p-1 md:hidden" aria-label="Open Navigation Menu" aria-expanded="false" aria-controls="mobile-menu">
                    <i class="ph ph-list" aria-hidden="true"></i>
                </button>
                {% endif %}
            </div>
        </div>
    </nav>

    {% if page.url == '/' %}
    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="mobile-menu-overlay" role="dialog" aria-modal="true" aria-labelledby="mobile-menu-title" aria-hidden="true">
        <div class="mobile-menu-panel">
            <h2 id="mobile-menu-title" class="sr-only">Navigation Menu</h2>
            <div class="flex justify-between items-center mb-8">
                <span class="text-xl font-bold font-mono tracking-tighter" aria-hidden="true">
                    <span class="text-kotlin-orange">&lt;</span>HG<span class="text-kotlin-orange">/&gt;</span>
                </span>
                <button id="mobile-menu-close" class="text-2xl text-ide-text-muted hover:text-ide-text-strong transition-colors p-1" aria-label="Close Navigation Menu">
                    <i class="ph ph-x" aria-hidden="true"></i>
                </button>
            </div>
            <div class="flex flex-col space-y-6 text-lg font-medium">
                <a href="#about" class="mobile-nav-link text-ide-text-muted hover:text-ide-text-strong transition-colors">{{ locales.en.nav_about }}</a>
                <a href="#projects" class="mobile-nav-link text-ide-text-muted hover:text-ide-text-strong transition-colors">{{ locales.en.nav_projects }}</a>
                <a href="#expertise" class="mobile-nav-link text-ide-text-muted hover:text-ide-text-strong transition-colors">{{ locales.en.nav_expertise }}</a>
                <a href="#contact" class="mobile-nav-link text-ide-text-muted hover:text-ide-text-strong transition-colors">{{ locales.en.nav_contact }}</a>
                <hr class="border-ide-border" aria-hidden="true">
                <a href="{{ '/about/' | url }}" class="mobile-nav-link inline-flex items-center gap-2 text-ide-text-muted hover:text-ide-text-strong transition-colors">{{ locales.en.nav_experience }}<i class="ph ph-arrow-up-right text-base"></i></a>
            </div>
            <div class="mt-8 pt-6 border-t border-ide-border flex items-center space-x-6 text-ide-text-muted">
                <a href="https://github.com/IronManYG" target="_blank" rel="noopener noreferrer" class="text-2xl hover:text-ide-text-strong transition-colors" aria-label="GitHub Profile"><i class="ph ph-github-logo"></i></a>
                <a href="https://www.linkedin.com/in/hussaingaddal/" target="_blank" rel="noopener noreferrer" class="text-2xl hover:text-[#79C0FF] transition-colors" aria-label="LinkedIn Profile"><i class="ph ph-linkedin-logo"></i></a>
                <a href="mailto:hussain.yg2010@gmail.com" rel="noopener noreferrer" class="text-2xl hover:text-kotlin-orange transition-colors" aria-label="Email"><i class="ph ph-envelope-simple"></i></a>
            </div>
        </div>
    </div>
    {% endif %}

    <main {% if page.url != '/' %}class="pt-32 pb-24 px-4 sm:px-6 max-w-4xl mx-auto"{% endif %}>
        {{ content | safe }}
    </main>

    {% if page.url == '/' %}
    <!-- Footer / Contact -->
    <footer id="contact" class="py-24 border-t border-ide-border bg-gradient-to-b from-ide-bg to-ide-bg-darker text-center overflow-hidden relative">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-kotlin-purple/10 blur-[120px] rounded-full pointer-events-none"></div>
        <div class="max-w-4xl mx-auto px-4 sm:px-6 fade-section relative z-10">
            <h2 class="text-3xl md:text-5xl font-bold mb-6">{{ locales.en.footer_title | safe }}</h2>
            <p class="text-ide-text-muted text-lg md:text-xl mb-12 max-w-2xl mx-auto leading-relaxed">
                {{ locales.en.footer_desc }}
            </p>
            <div class="flex flex-col md:flex-row justify-center items-center gap-6 mb-12">
                <div class="magnetic-wrap w-full md:w-auto">
                    <a href="mailto:hussain.yg2010@gmail.com" class="btn-primary text-lg px-10 py-5 shadow-kotlin-glow w-full">
                        {{ locales.en.btn_say_hello }} <i class="ph ph-paper-plane-tilt ml-2 text-xl"></i>
                    </a>
                </div>
                <div class="magnetic-wrap w-full md:w-auto">
                    <a href="tel:+966538517374" class="btn-secondary text-lg px-10 py-5 w-full flex items-center justify-center">
                        <i class="ph ph-phone mr-2 text-xl"></i> {{ locales.en.btn_phone }}
                    </a>
                </div>
            </div>
            <div class="flex flex-wrap justify-center items-center gap-8 text-ide-text-muted mb-16">
                <div class="flex items-center gap-2 font-mono text-sm">
                    <i class="ph ph-map-pin text-xl text-kotlin-orange"></i> {{ locales.en.location_sa }}
                </div>
                <div class="h-1 w-1 rounded-full bg-ide-border hidden md:block"></div>
                <div class="flex items-center gap-6">
                    <a href="https://github.com/IronManYG" target="_blank" rel="noopener noreferrer" class="text-3xl hover:text-ide-text-strong transition-all hover:-translate-y-1" aria-label="GitHub Profile">
                        <i class="ph ph-github-logo"></i>
                    </a>
                    <a href="https://www.linkedin.com/in/hussaingaddal/" target="_blank" rel="noopener noreferrer" class="text-3xl hover:text-[#79C0FF] transition-all hover:-translate-y-1" aria-label="LinkedIn Profile">
                        <i class="ph ph-linkedin-logo"></i>
                    </a>
                </div>
            </div>
            <p class="text-sm text-ide-text-dim font-mono border-t border-ide-border/50 pt-12">
                &copy; <span id="copyright-year"></span> Hussain Gaddal.
            </p>
        </div>
    </footer>
    {% else %}
    <footer class="py-12 border-t border-ide-border bg-ide-bg text-center text-ide-text-muted text-sm font-mono">
        &copy; <span id="copyright-year-sub"></span> Hussain Gaddal.
    </footer>
    {% endif %}

    <!-- Back to Top Button -->
    <button id="back-to-top" class="fixed bottom-8 right-8 z-40 w-12 h-12 rounded-full bg-kotlin-purple text-white shadow-lg shadow-kotlin-purple/30 flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 hover:bg-kotlin-orange hover:shadow-kotlin-orange/30 hover:-translate-y-1" aria-label="Back to top">
        <i class="ph ph-arrow-up text-xl"></i>
    </button>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js" defer></script>
    <script type="module" src="{{ '/js/main.js' | url }}" defer></script>
    <script>
        // Dynamic copyright year
        const yr = "2025-2026";
        const mainYr = document.getElementById('copyright-year');
        if (mainYr) mainYr.textContent = yr;
        const subYr = document.getElementById('copyright-year-sub');
        if (subYr) subYr.textContent = yr;
    </script>
</body>
</html>
