{#- Shared bilingual layout. `locale` comes from the data cascade: global
    default "en" (.eleventy.js), overridden to "ar" by src/ar/ar.11tydata.json.
    Everything locale-specific below derives from it:
      t      — UI strings for this locale (locales.json)
      isRtl  — direction switches (arrows, letter-spacing-sensitive classes)
      base   — URL prefix for internal links ('' or '/ar')
      enUrl  — this page's EN counterpart URL (drives hreflang + lang toggle) -#}
{%- set t = locales[locale] -%}
{%- set isRtl = locale == 'ar' -%}
{%- set base = '/ar' if isRtl else '' -%}
{%- set enUrl = page.url | replace("/ar/", "/", 1) if isRtl else page.url -%}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ 'rtl' if isRtl else 'ltr' }}" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default(t.site_title_default) }}</title>
    <meta name="description" content="{{ seo_description | default(description) | default(t.site_desc_default) }}">
    <link rel="icon" type="image/svg+xml" href="{{ '/favicon.svg' | url }}">

    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title | default(t.site_title_default) }}">
    <meta property="og:description" content="{{ seo_description | default(description) | default(t.site_desc_default) }}">
    <!-- `| url` already applies the /hussain-portfolio pathPrefix — never
         hardcode it in front of the filter or the path doubles up. -->
    <meta property="og:url" content="https://ironmanyg.github.io{{ page.url | url }}">
    <meta property="og:locale" content="{{ t.og_locale }}">
    <meta property="og:locale:alternate" content="{{ t.og_locale_alt }}">
    <meta name="twitter:card" content="summary_large_image">
    {% if noindex %}
    <meta name="robots" content="noindex">
    {% else %}
    <link rel="canonical" href="https://ironmanyg.github.io{{ page.url | url }}">
    <link rel="alternate" hreflang="en" href="https://ironmanyg.github.io{{ enUrl | url }}">
    <link rel="alternate" hreflang="ar" href="https://ironmanyg.github.io{{ ('/ar' + enUrl) | url }}">
    <link rel="alternate" hreflang="x-default" href="https://ironmanyg.github.io{{ enUrl | url }}">
    {% endif %}
    <meta property="og:image" content="https://ironmanyg.github.io{{ '/assets/img/branding/og_image.jpg' | url }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:image" content="https://ironmanyg.github.io{{ '/assets/img/branding/og_image.jpg' | url }}">
    <meta name="twitter:title" content="{{ title | default(t.site_title_default) }}">
    <meta name="twitter:description" content="{{ seo_description | default(description) | default(t.site_desc_default) }}">

    <script>
        // localStorage throws in Safari Private Browsing and when site data is
        // blocked; without the guard the throw also skipped the js/is-shown
        // gates below, which arm the entrance animations.
        let savedTheme = null;
        try { savedTheme = localStorage.getItem('theme'); } catch (e) { /* no persisted choice available */ }
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const useDark = savedTheme ? savedTheme === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', useDark);

        // Entrance-animation gates: `js` arms the CSS hidden states (no-JS
        // visitors never get content hidden); `is-shown` starts the hero
        // stagger only once the page is actually displayed — after
        // `prerenderingchange` for Speculation-Rules prerenders, otherwise the
        // one-shot entrance would play invisibly before the user clicks.
        document.documentElement.classList.add('js');
        if (document.prerendering) {
            document.addEventListener('prerenderingchange', () => {
                document.documentElement.classList.add('is-shown');
            }, { once: true });
        } else {
            document.documentElement.classList.add('is-shown');
        }
    </script>

    <!-- Self-hosted fonts (no external CDN on the critical path). The @font-face
         rules live in the render-blocking styles.css, so the real fonts are known
         at first paint; preloading the above-the-fold weights (per-script subset)
         means text + icons paint in final form immediately — no fallback->webfont
         swap (the FOUT that read as a blank flash on every page navigation). -->
    {% if isRtl %}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/fonts/IBMPlexSansArabic-400-arabic.woff2' | url }}">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/fonts/IBMPlexSansArabic-600-arabic.woff2' | url }}">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/fonts/IBMPlexSansArabic-700-arabic.woff2' | url }}">
    {% else %}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/fonts/IBMPlexSansArabic-400-latin.woff2' | url }}">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/fonts/IBMPlexSansArabic-600-latin.woff2' | url }}">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/fonts/IBMPlexSansArabic-700-latin.woff2' | url }}">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/fonts/JetBrainsMono-400-latin.woff2' | url }}">
    {% endif %}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ '/assets/fonts/Phosphor-regular-subset.woff2' | url }}">
    <link rel="stylesheet" href="{{ '/styles.css' | url }}">

    <!-- Hold the first render until the page body is parsed, so the View-
         Transition swap reveals a COMPLETE frame (not the near-black first paint
         that flashed). Pairs with @view-transition in styles.css. -->
    <link rel="expect" href="#rt-render-ready" blocking="render">

    <link rel="manifest" href="{{ ('/manifest.ar.json' if isRtl else '/manifest.json') | url }}">
    {# Browser/PWA chrome. Two media-scoped tags rather than one hardcoded dark
       value, which painted dark chrome around the sandstone light theme. This
       resolves with zero JS for anyone whose theme matches their OS; theme.js
       flips the media on an explicit choice, the same way it re-points the
       thumbnail <source>s. #}
    <meta name="theme-color" data-theme-color="light" media="(prefers-color-scheme: light)" content="#f5efe6">
    <meta name="theme-color" data-theme-color="dark" media="(prefers-color-scheme: dark)" content="#15140f">
</head>
<body class="bg-rt-bg text-rt-text font-display antialiased selection:bg-rt-accent/25 selection:text-rt-text">

    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:start-4 focus:z-[110] focus:bg-rt-accent focus:text-rt-btn-text focus:font-semibold focus:px-4 focus:py-2 focus:rounded-lg">{{ t.skip_to_content }}</a>

    <!-- Whole-page green ambiance: several soft accent glows spread across the
         page, behind the content (opaque facts/cards/footer cover them, so the
         section bands stay clean — only the transparent hero + section
         backgrounds pick up the green). -->
    <div class="page-glow" aria-hidden="true"></div>
    <!-- Static film-grain atmosphere (no animation), behind content. -->
    <div class="grain-overlay" aria-hidden="true"></div>

    <!-- Navbar -->
    {% set isHome = page.url == base + '/' %}
    <nav class="fixed w-full z-50 top-0 border-b border-rt-border bg-rt-bg/80 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            {% if isHome %}
            <a href="{{ (base + '/') | url }}" class="flex items-center gap-2.5 group" aria-label="{{ t.home_aria }}">
                <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-rt-accent to-rt-accent-2 flex items-center justify-center font-mono font-bold text-xs text-[#0e1014]" aria-hidden="true">HG</span>
                <span class="font-semibold text-rt-text">{{ t.brand_name }}</span>
            </a>

            <div class="hidden md:flex items-center gap-7 text-sm text-rt-muted">
                <a href="#about" data-spy="about" class="rt-nav-link hover:text-rt-text transition-colors">{{ t.nav_about }}</a>
                <a href="#projects" data-spy="projects" class="rt-nav-link hover:text-rt-text transition-colors">{{ t.nav_work }}</a>
                <a href="#expertise" data-spy="expertise" class="rt-nav-link hover:text-rt-text transition-colors">{{ t.nav_skills }}</a>
                <a href="#contact" data-spy="contact" class="rt-nav-link hover:text-rt-text transition-colors">{{ t.nav_contact }}</a>
                <span class="h-4 w-px bg-rt-border" aria-hidden="true"></span>
                <a href="{{ (base + '/projects/') | url }}" class="rt-nav-link hover:text-rt-text transition-colors">{{ t.nav_projects }}</a>
                <a href="{{ (base + '/about/') | url }}" class="rt-nav-link hover:text-rt-text transition-colors">{{ t.nav_experience }}</a>
            </div>
            {% else %}
            <!-- Static, page-aware back link. Project-detail pages go up to the
                 Projects index (`backTo: projects` in their front matter); the
                 top-level sub-pages (Projects, About) go up to the Portfolio home.
                 No document.referrer / history.back() — those were unreliable: the
                 prev/next chain + Speculation-Rules prerendering (the homepage
                 prerenders project links from "Selected work") bake a stale referrer
                 into the cached page. A fixed URL is prerendered → instant. -->
            {% if backTo == 'projects' %}
            <a href="{{ (base + '/projects/') | url }}" class="inline-flex items-center gap-2 text-sm text-rt-muted hover:text-rt-text transition-colors">
                <i class="ph {{ 'ph-arrow-right' if isRtl else 'ph-arrow-left' }} text-base" aria-hidden="true"></i> {{ t.back_projects }}
            </a>
            {% else %}
            <a href="{{ (base + '/') | url }}" class="inline-flex items-center gap-2 text-sm text-rt-muted hover:text-rt-text transition-colors">
                <i class="ph {{ 'ph-arrow-right' if isRtl else 'ph-arrow-left' }} text-base" aria-hidden="true"></i> {{ t.back_portfolio }}
            </a>
            {% endif %}
            {% endif %}

            <div class="flex items-center gap-3 text-rt-muted">
                {% if repoUrl %}
                <a href="{{ repoUrl }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 bg-rt-accent text-rt-btn-text text-sm font-semibold px-4 py-2 rounded-[10px] hover:brightness-110 transition">
                    <i class="ph ph-github-logo text-base"></i> {{ t.btn_view_code }}
                </a>
                {% endif %}
                <a href="https://github.com/IronManYG" target="_blank" rel="noopener noreferrer" class="rt-tap hidden md:inline-flex text-xl hover:text-rt-text transition-colors p-2" aria-label="{{ t.aria_github }}"><i class="ph ph-github-logo" aria-hidden="true"></i></a>
                <a href="https://www.linkedin.com/in/hussaingaddal/" target="_blank" rel="noopener noreferrer" class="rt-tap hidden md:inline-flex text-xl hover:text-rt-accent transition-colors p-2" aria-label="{{ t.aria_linkedin }}"><i class="ph ph-linkedin-logo" aria-hidden="true"></i></a>
                <button id="theme-toggle" class="rt-tap text-xl hover:text-rt-text transition-colors p-2" aria-label="{{ t.theme_toggle_aria }}" data-label-light="{{ t.theme_label_light }}" data-label-dark="{{ t.theme_label_dark }}">
                    <i class="ph ph-moon" id="theme-icon"></i>
                </button>
                {# Active language is bold + full text color; the target stays
                   muted and brightens on hover, so the toggle reads as state,
                   not just a button. #}
                {% if isRtl %}
                <a href="{{ enUrl | url }}" id="lang-toggle" class="group font-mono text-xs whitespace-nowrap border border-rt-border px-2 py-1 rounded" aria-label="{{ t.lang_toggle_aria }}"><span class="group-hover:text-rt-text transition-colors">EN</span> / <span class="font-bold text-rt-text">ع</span></a>
                {% else %}
                <a href="{{ '/ar' | url }}{{ page.url }}" id="lang-toggle" class="group font-mono text-xs whitespace-nowrap border border-rt-border px-2 py-1 rounded" aria-label="{{ t.lang_toggle_aria }}"><span class="font-bold text-rt-text">EN</span> / <span class="group-hover:text-rt-text transition-colors">ع</span></a>
                {% endif %}
                <button id="mobile-menu-btn" class="rt-tap text-2xl hover:text-rt-text transition-colors p-1 md:hidden" aria-label="{{ t.menu_open }}" aria-expanded="false" aria-controls="mobile-menu">
                    <i class="ph ph-list" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu Overlay — rendered on every page so deep-link visitors
         (recruiters usually land on a project page) can still reach About /
         Projects on mobile. On sub-pages the section links point back to the
         homepage sections; #contact stays local (the footer is on every page). -->
    {% set anchorBase = '' if isHome else ((base + '/') | url) %}
    <div id="mobile-menu" class="mobile-menu-overlay" role="dialog" aria-modal="true" aria-labelledby="mobile-menu-title" aria-hidden="true">
        <div class="mobile-menu-panel">
            <h2 id="mobile-menu-title" class="sr-only">{{ t.menu_title }}</h2>
            <div class="flex justify-between items-center mb-8">
                <span class="flex items-center gap-2.5" aria-hidden="true">
                    <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-rt-accent to-rt-accent-2 flex items-center justify-center font-mono font-bold text-xs text-[#0e1014]">HG</span>
                </span>
                <button id="mobile-menu-close" class="rt-tap text-2xl text-rt-muted hover:text-rt-text transition-colors p-1" aria-label="{{ t.menu_close }}">
                    <i class="ph ph-x" aria-hidden="true"></i>
                </button>
            </div>
            <div class="flex flex-col space-y-6 text-lg font-medium">
                <a href="{{ anchorBase }}#about" data-spy="about" class="mobile-nav-link text-rt-muted hover:text-rt-text transition-colors">{{ t.nav_about }}</a>
                <a href="{{ anchorBase }}#projects" data-spy="projects" class="mobile-nav-link text-rt-muted hover:text-rt-text transition-colors">{{ t.nav_work }}</a>
                <a href="{{ anchorBase }}#expertise" data-spy="expertise" class="mobile-nav-link text-rt-muted hover:text-rt-text transition-colors">{{ t.nav_skills }}</a>
                <a href="#contact" data-spy="contact" class="mobile-nav-link text-rt-muted hover:text-rt-text transition-colors">{{ t.nav_contact }}</a>
                <hr class="border-rt-border" aria-hidden="true">
                <a href="{{ (base + '/projects/') | url }}" class="mobile-nav-link text-rt-muted hover:text-rt-text transition-colors">{{ t.nav_projects }}</a>
                <a href="{{ (base + '/about/') | url }}" class="mobile-nav-link text-rt-muted hover:text-rt-text transition-colors">{{ t.nav_experience }}</a>
            </div>
            <div class="mt-8 pt-6 border-t border-rt-border flex items-center gap-6 text-rt-muted">
                <a href="https://github.com/IronManYG" target="_blank" rel="noopener noreferrer" class="rt-tap text-2xl hover:text-rt-text transition-colors" aria-label="{{ t.aria_github }}"><i class="ph ph-github-logo"></i></a>
                <a href="https://www.linkedin.com/in/hussaingaddal/" target="_blank" rel="noopener noreferrer" class="rt-tap text-2xl hover:text-rt-accent transition-colors" aria-label="{{ t.aria_linkedin }}"><i class="ph ph-linkedin-logo"></i></a>
                <a href="mailto:hussain.yg2010@gmail.com" rel="noopener noreferrer" class="rt-tap text-2xl hover:text-rt-accent transition-colors" aria-label="{{ t.aria_email }}"><i class="ph ph-envelope-simple"></i></a>
            </div>
        </div>
    </div>

    <main id="main-content" class="relative z-10">
        {{ content | safe }}
    </main>

    <!-- Contact / Footer -->
    <footer id="contact" class="relative z-10 border-t border-rt-border bg-rt-subtle">
        <div data-reveal class="max-w-4xl mx-auto px-6 py-20 text-center">
            {# uppercase/tracking only for Latin — letter-spacing breaks joined Arabic script #}
            <p class="font-mono text-xs {{ '' if isRtl else 'uppercase tracking-[0.12em] ' }}text-rt-muted mb-4">{{ t.footer_eyebrow }}</p>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">{{ t.footer_heading }}</h2>
            <p class="text-rt-muted text-lg mb-10 max-w-2xl mx-auto leading-relaxed">{{ t.footer_lede }}</p>
            <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mb-12">
                <a href="mailto:hussain.yg2010@gmail.com" class="inline-flex items-center gap-2 bg-rt-accent text-rt-btn-text font-semibold px-6 py-3 rounded-[10px] hover:brightness-110 hover:-translate-y-0.5 transition-all">
                    {{ t.btn_say_hello }} <i class="ph ph-paper-plane-tilt"></i>
                </a>
                <a href="tel:+966538517374" dir="ltr" class="inline-flex items-center gap-2 border border-rt-border text-rt-text font-medium px-6 py-3 rounded-[10px] hover:border-rt-accent transition-colors">
                    <i class="ph ph-phone"></i> +966 53 851 7374
                </a>
            </div>
            <div class="flex flex-wrap justify-center items-center gap-6 text-rt-muted mb-10">
                <span class="flex items-center gap-2 font-mono text-sm"><i class="ph ph-map-pin text-rt-accent"></i> {{ t.footer_location }}</span>
                <span class="h-1 w-1 rounded-full bg-rt-border hidden sm:block" aria-hidden="true"></span>
                <a href="https://github.com/IronManYG" target="_blank" rel="noopener noreferrer" class="rt-tap text-2xl hover:text-rt-text transition-colors" aria-label="{{ t.aria_github }}"><i class="ph ph-github-logo"></i></a>
                <a href="https://www.linkedin.com/in/hussaingaddal/" target="_blank" rel="noopener noreferrer" class="rt-tap text-2xl hover:text-rt-accent transition-colors" aria-label="{{ t.aria_linkedin }}"><i class="ph ph-linkedin-logo"></i></a>
            </div>
            <p class="font-mono text-xs text-rt-muted border-t border-rt-border pt-8">&copy; <bdi>{{ "2025" | locNum(locale) }}{% if buildYear > 2025 %}–{{ buildYear | locNum(locale) }}{% endif %}</bdi> {{ t.copyright_name }}.</p>
        </div>
    </footer>

    <!-- Back to top -->
    <button id="back-to-top" class="rt-fab" aria-label="{{ t.back_to_top }}">
        <i class="ph ph-arrow-up text-xl" aria-hidden="true"></i>
    </button>

    <!-- Sentinel for <link rel="expect" blocking="render"> — its presence in the
         parsed DOM is what releases the held first render (complete-frame reveal). -->
    <div id="rt-render-ready" hidden></div>

    <script type="module">
        import { initTheme } from '{{ "/js/theme.js" | url }}';
        import { initMenu } from '{{ "/js/menu.js" | url }}';
        import { initNav } from '{{ "/js/nav.js" | url }}';
        import { initReveal } from '{{ "/js/reveal.js" | url }}';
        initTheme();
        initMenu();
        initNav();
        initReveal();
    </script>

    <!-- Speculation Rules: prerender same-origin pages on hover/touch intent so
         navigation is INSTANT (the page is fully rendered before the click) — no
         navigation gap to flash, in any Chromium browser incl. Arc. Excludes the
         CV PDF; cross-origin links (GitHub/LinkedIn) are never prerendered. -->
    <script type="speculationrules">
    {
      "prerender": [
        {
          "where": {
            "and": [
              { "href_matches": "/hussain-portfolio/*" },
              { "not": { "href_matches": "/hussain-portfolio/cv/*" } }
            ]
          },
          "eagerness": "moderate"
        }
      ]
    }
    </script>
</body>
</html>
