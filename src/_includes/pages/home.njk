{%- set t = locales[locale] -%}
{%- set isRtl = locale == 'ar' -%}
{%- set base = '/ar' if isRtl else '' -%}
{%- set h = home[locale] -%}
<!-- ───────── Hero ───────── -->
<header class="relative max-w-7xl mx-auto px-6 pt-32 pb-16 lg:pt-40 lg:pb-24">
    <div class="relative z-[1] grid lg:grid-cols-[1.4fr_1fr] gap-12 lg:gap-16 items-center">
        <!-- Copy -->
        <div>
            <div data-hero style="--hero-step:0" class="inline-flex items-center gap-2 font-mono text-xs text-rt-muted border border-rt-border bg-rt-surface px-3 py-1.5 rounded-full mb-6">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                {{ h.hero.badge }}
            </div>
            <p data-hero style="--hero-step:1" class="font-mono text-sm text-rt-muted mb-4">{{ h.hero.greeting }}</p>
            <h1 data-hero style="--hero-step:2" class="rt-em text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-tight mb-6">{{ h.hero.headline | safe }}</h1>
            <p data-hero style="--hero-step:3" class="text-lg text-rt-muted leading-relaxed max-w-xl mb-8">{{ h.hero.subtitle | safe }}</p>
            <div data-hero style="--hero-step:4" class="flex flex-wrap items-center gap-3">
                <a href="#projects" class="inline-flex items-center gap-2 bg-rt-accent text-rt-btn-text font-semibold px-5 py-3 rounded-[10px] hover:brightness-110 hover:-translate-y-0.5 transition-all">
                    {{ h.hero.btn_work }} <span class="font-mono">{{ '←' if isRtl else '→' }}</span>
                </a>
                <a href="{{ '/cv/Hussain_Gaddal_CV.pdf' | url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-rt-border text-rt-text font-medium px-5 py-3 rounded-[10px] hover:border-rt-accent transition-colors">
                    <i class="ph ph-file-pdf"></i> {{ h.hero.btn_cv }}
                </a>
            </div>
        </div>

        <!-- Portrait card + stats -->
        <div data-hero style="--hero-step:5" class="rt-card border border-rt-border rounded-2xl overflow-hidden bg-rt-surface transition-all duration-300">
            <img src="{{ '/assets/img/hussain-portrait.webp' | url }}" alt="{{ 'حسين قدال — مطور تطبيقات أندرويد في الرياض' if isRtl else 'Hussain Gaddal — Android Developer in Riyadh' }}"
                 width="2400" height="1600" fetchpriority="high"
                 class="w-full aspect-[4/5] object-cover" style="object-position: 28% 20%;">
            <div class="grid grid-cols-3 border-t border-rt-border">
                {% for s in h.hero.stats %}
                <div class="px-4 py-3.5 {% if not loop.last %}border-e border-rt-border{% endif %}">
                    <div class="text-xl font-bold leading-none"><bdi{% if s.n %} data-countup="{{ s.n }}" data-countup-suffix="{{ s.suffix | default('') }}"{% endif %}>{{ s.v }}</bdi></div>
                    <div class="font-mono text-[10px] uppercase tracking-wide text-rt-muted mt-1">{{ s.k }}</div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</header>

<!-- ───────── Facts strip ───────── -->
<section class="border-y border-rt-border bg-rt-subtle">
    <div class="max-w-7xl mx-auto px-6 flex flex-wrap">
        {% for f in h.facts %}
        <div data-reveal class="flex-1 min-w-[50%] sm:min-w-0 px-5 py-5 {% if not loop.last %}sm:border-e border-rt-border{% endif %}">
            <div class="font-mono text-[10px] uppercase tracking-[0.08em] text-rt-muted">{{ f.k }}</div>
            <div class="text-[15px] text-rt-text mt-1.5"><bdi>{{ f.v }}</bdi></div>
        </div>
        {% endfor %}
    </div>
</section>

<!-- ───────── About teaser ───────── -->
<section id="about" class="max-w-7xl mx-auto px-6 py-20 lg:py-24">
    <div class="grid lg:grid-cols-[1fr_1.25fr] gap-10 lg:gap-16 items-start">
        <div data-reveal>
            <div class="font-mono text-xs uppercase tracking-[0.1em] text-rt-muted mb-3">{{ h.about.section_label }}</div>
            <h2 class="rt-em text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight tracking-tight">{{ h.about.title | safe }}</h2>
        </div>
        <div data-reveal>
            {% for p in h.about.paragraphs.slice(0, 3) %}
            <p class="text-rt-muted leading-relaxed{% if not loop.last %} mb-4{% endif %}">{{ p | safe }}</p>
            {% endfor %}
            <a href="{{ (base + '/about/') | url }}" class="inline-flex items-center gap-2 text-sm text-rt-accent hover:brightness-110 transition mt-6">
                {{ 'المزيد عنّي' if isRtl else 'More about me' }} <span class="font-mono">{{ '←' if isRtl else '→' }}</span>
            </a>
        </div>
    </div>
</section>

<!-- ───────── Selected work ───────── -->
<section id="projects" class="border-t border-rt-border max-w-7xl mx-auto px-6 py-20 lg:py-24">
    <div data-reveal class="flex items-end justify-between gap-6 mb-10">
        <div>
            <div class="font-mono text-xs uppercase tracking-[0.1em] text-rt-muted mb-2">{{ h.featured_projects.section_label }}</div>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight">{{ h.featured_projects.title }}</h2>
        </div>
        <a href="{{ (base + '/projects/') | url }}" class="hidden sm:inline-flex items-center gap-2 text-sm text-rt-accent hover:brightness-110 transition">
            {{ t.breadcrumb_projects }} <span class="font-mono">{{ '←' if isRtl else '→' }}</span>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
        {% for project in projects %}{% if project.featured %}
        {% set pTitle = project['title_' + locale] %}
        {% set pDesc = project['description_' + locale] %}
        {% set pImpact = project['card_impact_' + locale] %}
        {% if project.feature_card %}
        <!-- Feature card (span-12, 2-col, whole thumbnail visible) -->
        <a data-reveal href="{{ (base + '/' + project.slug + '/') | url }}" class="rt-card group md:col-span-12 grid md:grid-cols-[1.4fr_1fr] border border-rt-border rounded-2xl overflow-hidden bg-rt-surface transition-all duration-300">
            <div class="relative aspect-video overflow-hidden bg-rt-subtle">
                {# One <img>, not a stacked light/dark pair: both halves of a
                   pair download even when one is hidden, which doubled the
                   thumbnail payload. <source> resolves the theme in CSS, so
                   only the matching file is ever fetched; theme.js re-points
                   it for anyone whose explicit choice differs from their OS. #}
                {% if project.grid.images %}
                <picture>
                    <source data-thumb-dark media="(prefers-color-scheme: dark)" srcset="{{ project.grid.images[locale].dark | url }}">
                    <img src="{{ project.grid.images[locale].light | url }}" alt="{{ pTitle }}" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover">
                </picture>
                {% endif %}
            </div>
            <div class="p-6 sm:p-8 flex flex-col justify-center">
                <div class="flex flex-wrap gap-2 mb-3 font-mono">
                    {% for tag in project.tags.slice(0, 3) %}<span class="text-[10px] px-2 py-0.5 rounded-full bg-rt-subtle text-rt-muted border border-rt-border" dir="ltr">{{ tag }}</span>{% endfor %}
                </div>
                <h3 class="text-2xl font-bold tracking-tight mb-2 group-hover:text-rt-accent transition-colors">{{ pTitle }}{% if project.year %} <span class="text-rt-muted font-normal text-lg">· <bdi>{{ project.year | locNum(locale) }}</bdi></span>{% endif %}</h3>
                <p class="text-rt-muted leading-relaxed{% if pImpact %} mb-5{% endif %}">{{ pDesc }}</p>
                {% if pImpact %}
                <div class="pt-4 border-t border-rt-border">
                    <span class="font-mono text-sm text-rt-accent">{{ pImpact }}</span>
                </div>
                {% endif %}
            </div>
        </a>
        {% else %}
        <!-- Standard card (span-4) -->
        <a data-reveal href="{{ (base + '/' + project.slug + '/') | url }}" class="rt-card group md:col-span-4 flex flex-col border border-rt-border rounded-2xl overflow-hidden bg-rt-surface transition-all duration-300">
            <div class="relative aspect-video overflow-hidden bg-rt-subtle">
                {# One <img>, not a stacked light/dark pair: both halves of a
                   pair download even when one is hidden, which doubled the
                   thumbnail payload. <source> resolves the theme in CSS, so
                   only the matching file is ever fetched; theme.js re-points
                   it for anyone whose explicit choice differs from their OS. #}
                {% if project.grid.images %}
                <picture>
                    <source data-thumb-dark media="(prefers-color-scheme: dark)" srcset="{{ project.grid.images[locale].dark | url }}">
                    <img src="{{ project.grid.images[locale].light | url }}" alt="{{ pTitle }}" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover">
                </picture>
                {% endif %}
            </div>
            <div class="p-5 flex flex-col flex-1">
                <div class="flex flex-wrap gap-2 mb-3 font-mono">
                    {% for tag in project.tags.slice(0, 2) %}<span class="text-[10px] px-2 py-0.5 rounded-full bg-rt-subtle text-rt-muted border border-rt-border" dir="ltr">{{ tag }}</span>{% endfor %}
                </div>
                <h3 class="text-lg font-bold tracking-tight mb-1.5 group-hover:text-rt-accent transition-colors">{{ pTitle }}{% if project.year %} <span class="text-rt-muted font-normal text-sm">· <bdi>{{ project.year | locNum(locale) }}</bdi></span>{% endif %}</h3>
                <p class="text-sm text-rt-muted leading-relaxed mb-4">{{ pDesc }}</p>
                {% if pImpact %}
                <div class="mt-auto pt-3 border-t border-rt-border">
                    <span class="font-mono text-xs text-rt-accent">{{ pImpact }}</span>
                </div>
                {% endif %}
            </div>
        </a>
        {% endif %}
        {% endif %}{% endfor %}
    </div>

    <div class="mt-10 text-center sm:hidden">
        <a href="{{ (base + '/projects/') | url }}" class="inline-flex items-center gap-2 text-sm text-rt-accent">{{ t.breadcrumb_projects }} <span class="font-mono">{{ '←' if isRtl else '→' }}</span></a>
    </div>
</section>

<!-- ───────── Skills / Expertise ───────── -->
<section id="expertise" class="border-t border-rt-border">
    <div class="max-w-7xl mx-auto px-6 py-20 lg:py-24">
        <div data-reveal class="mb-10">
            <div class="font-mono text-xs uppercase tracking-[0.1em] text-rt-muted mb-2">{{ h.expertise.section_label }}</div>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight">{{ h.expertise.title }}</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {% for item in h.expertise.items %}
            <div data-reveal class="border border-rt-border rounded-2xl bg-rt-surface p-6">
                <div class="w-11 h-11 rounded-xl bg-rt-accent/10 text-rt-accent flex items-center justify-center mb-4">
                    <i class="ph {{ item.icon }} text-xl" aria-hidden="true"></i>
                </div>
                <h3 class="text-lg font-bold tracking-tight mb-2">{{ item.title }}</h3>
                <p class="text-sm text-rt-muted leading-relaxed">{{ item.description | safe }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
