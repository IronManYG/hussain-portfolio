{%- set t = locales[locale] -%}
{%- set isRtl = locale == 'ar' -%}
{%- set base = '/ar' if isRtl else '' -%}
{% set nonTech = nonTechTags.concat(["Android"]) %}
{% set prodSlugs = ["maktabati", "sifr", "qodem"] %}

<!-- ───────── Head + filters ───────── -->
<header class="max-w-7xl mx-auto px-6 pt-32 pb-10 lg:pt-40">
    <div class="flex items-end justify-between gap-6 flex-wrap">
        <div>
            <div class="font-mono text-xs uppercase tracking-[0.1em] text-rt-muted mb-3">{{ 'أعمال مختارة' if isRtl else 'Selected work' }}</div>
            <h1 class="rt-em text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-tight max-w-2xl">{{ 'كافة المشاريع' if isRtl else 'All Projects' }}</h1>
            <p class="text-lg text-rt-muted leading-relaxed max-w-2xl mt-5">{{ 'أرشيف يضم أعمالي الاحترافية، وتحديات المجتمع التقني، وتجاربي الشخصية — تطبيقات إنتاجية، ومشاريع متعددة المنصات، وأدوات صغيرة بنيتُها للتعلّم. مُرتَّبة حسب ما علّمتني.' if isRtl else 'An archive of my professional work, community challenges, and personal experiments — production apps, multiplatform builds, and small tools I made to learn. Ordered by how much they taught me.' }}</p>
        </div>
        {# Count is computed; the range end is the newest data year. The 2020
           start predates the dated entries (early projects carry no year). #}
        {% set years = [] %}{% for p in projects %}{% if p.year %}{% set years = (years.push(p.year), years) %}{% endif %}{% endfor %}
        <div class="font-mono text-xs text-rt-muted shrink-0"><bdi><b class="text-rt-text font-semibold">{{ projects | length | locNum(locale) }} {{ 'مشروعاً' if isRtl else 'projects' }}</b> · {{ "2020" | locNum(locale) }} — {{ years | sort | last | locNum(locale) }}</bdi></div>
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap items-center gap-2 mt-8 pt-6 border-t border-rt-border" id="project-filters" role="toolbar" aria-label="{{ 'تصفية المشاريع حسب الفئة' if isRtl else 'Project category filters' }}">
        <button class="rt-chip is-active" data-filter="all" aria-pressed="true">{{ 'الكل' if isRtl else 'All' }} <span class="rt-chip-count" aria-hidden="true">0</span></button>
        <button class="rt-chip" data-filter="production" aria-pressed="false">{{ 'إنتاجي' if isRtl else 'Production' }} <span class="rt-chip-count" aria-hidden="true">0</span></button>
        <button class="rt-chip" data-filter="multiplatform" aria-pressed="false">{{ 'متعدد المنصات' if isRtl else 'Multiplatform' }} <span class="rt-chip-count" aria-hidden="true">0</span></button>
        <button class="rt-chip" data-filter="opensource" aria-pressed="false">{{ 'مفتوح المصدر' if isRtl else 'Open-source' }} <span class="rt-chip-count" aria-hidden="true">0</span></button>
        <span class="font-mono text-[11px] text-rt-muted border border-dashed border-rt-border rounded-full px-3 py-1.5 sm:ms-auto">{{ 'جميع المشاريع تستخدم Kotlin · Compose ما لم يُذكر غير ذلك' if isRtl else 'All projects use Kotlin · Compose unless noted' }}</span>
    </div>
</header>

<!-- ───────── Featured project ───────── -->
{% for project in projects %}{% if project.feature_card %}
{% set tl = project.tags | join('|') | lower %}
{% set isMp = ('multiplatform' in tl) or ('kmm' in tl) or ('kmp' in tl) or ('cmp' in tl) or ('wear os' in tl) %}
{% set isProd = project.slug in prodSlugs %}
{% set pTitle = project['title_' + locale] %}
<section class="featured-card-wrapper max-w-7xl mx-auto px-6 pb-12" data-multiplatform="{{ 'true' if isMp else 'false' }}" data-production="{{ 'true' if isProd else 'false' }}" data-opensource="{{ 'true' if project.repoUrl else 'false' }}">
    <div data-reveal class="rt-card grid md:grid-cols-[1.1fr_1fr] border border-rt-border rounded-2xl overflow-hidden bg-rt-surface transition-all duration-300">
        <a href="{{ (base + '/' + project.slug + '/') | url }}" class="group relative block aspect-video md:aspect-auto md:min-h-[340px] overflow-hidden bg-rt-subtle" aria-label="{{ pTitle }} — {{ 'دراسة حالة' if isRtl else 'case study' }}">
            <span class="absolute top-4 start-4 z-10 font-mono text-[10px] uppercase tracking-[0.14em] text-rt-btn-text bg-rt-accent px-2.5 py-1 rounded-full">{{ 'مميَّز' if isRtl else 'Featured' }}</span>
            {# Single <img> — see the note in pages/home.njk. The wrapping <a>
               already carries an aria-label, so alt stays descriptive here. #}
            {% if project.grid.images %}
            <picture>
                <source data-thumb-dark media="(prefers-color-scheme: dark)" srcset="{{ project.grid.images[locale].dark | url }}">
                <img src="{{ project.grid.images[locale].light | url }}" alt="{{ pTitle }}" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover">
            </picture>
            {% endif %}
        </a>
        <div class="p-6 sm:p-8 lg:p-10 flex flex-col justify-center">
            <div class="font-mono text-[11px] uppercase tracking-[0.12em] text-rt-accent mb-3"><bdi>{{ project.year | locNum(locale) }}</bdi>{% if project['feature_label_' + locale] %} · {{ project['feature_label_' + locale] }}{% endif %}</div>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight mb-3"><a href="{{ (base + '/' + project.slug + '/') | url }}" class="hover:text-rt-accent transition-colors">{{ pTitle }}</a></h2>
            <p class="text-sm text-rt-muted leading-relaxed mb-6">{{ project['featured_role_' + locale] | safe }}</p>
            {% if project['featured_stats_' + locale] %}
            <div class="grid grid-cols-3 border-y border-rt-border mb-6">
                {% for s in project['featured_stats_' + locale] %}
                <div class="py-3.5 {% if not loop.first %}border-s border-rt-border ps-4{% endif %}">
                    <div class="text-2xl font-bold leading-none tracking-tight"><bdi>{{ s.v }}</bdi></div>
                    <div class="font-mono text-[10px] uppercase tracking-wide text-rt-muted mt-1.5">{{ s.k }}</div>
                </div>
                {% endfor %}
            </div>
            {% endif %}
            <div class="flex flex-wrap gap-1.5 mb-6 font-mono">
                {% for tag in project.tags %}{% if tag not in nonTech %}<span class="text-[10.5px] px-2.5 py-1 rounded bg-rt-subtle text-rt-muted border border-rt-border">{{ tag }}</span>{% endif %}{% endfor %}
            </div>
            <div class="flex flex-wrap items-center gap-4">
                <a href="{{ (base + '/' + project.slug + '/') | url }}" class="inline-flex items-center gap-2 bg-rt-accent text-rt-btn-text font-semibold px-5 py-2.5 rounded-[10px] hover:brightness-110 hover:-translate-y-0.5 transition-all">{{ 'اقرأ دراسة الحالة' if isRtl else 'Read case study' }} <span class="font-mono">{{ '←' if isRtl else '→' }}</span></a>
                {% if project.repoUrl %}<a href="{{ project.repoUrl }}" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-rt-muted hover:text-rt-accent transition-colors">GitHub ↗</a>{% endif %}
            </div>
        </div>
    </div>
</section>
{% endif %}{% endfor %}

<!-- ───────── Project grid ───────── -->
<section class="max-w-7xl mx-auto px-6 pb-24">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="projects-grid">
        {% for project in projects %}{% if not project.feature_card %}
        {% set tl = project.tags | join('|') | lower %}
        {% set isMp = ('multiplatform' in tl) or ('kmm' in tl) or ('kmp' in tl) or ('cmp' in tl) or ('wear os' in tl) %}
        {% set isProd = project.slug in prodSlugs %}
        <div class="project-card-wrapper" data-multiplatform="{{ 'true' if isMp else 'false' }}" data-production="{{ 'true' if isProd else 'false' }}" data-opensource="{{ 'true' if project.repoUrl else 'false' }}">
            <a data-reveal href="{{ (base + '/' + project.slug + '/') | url }}" class="rt-card group flex flex-col h-full border border-rt-border rounded-2xl bg-rt-surface p-6 transition-all duration-300">
                <div class="flex items-baseline justify-between gap-3 mb-2">
                    <h3 class="text-lg sm:text-xl font-bold tracking-tight group-hover:text-rt-accent transition-colors">{{ project['title_' + locale] }}</h3>
                    {% if project.year %}<span class="font-mono text-[11px] tracking-[0.1em] text-rt-muted shrink-0"><bdi>{{ project.year | locNum(locale) }}</bdi></span>{% endif %}
                </div>
                <p class="text-sm text-rt-muted leading-relaxed">{{ project['description_' + locale] }}</p>
                {% if project['card_impact_' + locale] %}
                <div class="font-mono text-xs text-rt-accent border-t border-dashed border-rt-border mt-4 pt-3">{{ project['card_impact_' + locale] }}</div>
                {% endif %}
                <div class="flex items-center justify-between gap-3 mt-auto pt-4">
                    <div class="flex flex-wrap gap-1.5 font-mono">
                        {% for tag in project.tags %}{% if tag not in nonTech and loop.index <= 4 %}<span class="text-[10px] px-2 py-0.5 rounded bg-rt-subtle text-rt-muted border border-rt-border">{{ tag }}</span>{% endif %}{% endfor %}
                    </div>
                    <span class="font-mono text-xs text-rt-muted group-hover:text-rt-accent transition-colors shrink-0">{{ 'عرض' if isRtl else 'View' }} {{ '←' if isRtl else '→' }}</span>
                </div>
            </a>
        </div>
        {% endif %}{% endfor %}
    </div>
    <div id="projects-empty" class="hidden text-center py-16 text-rt-muted text-lg" role="status" aria-live="polite">{{ 'لا توجد مشاريع مطابقة لهذا التصنيف.' if isRtl else 'No projects match that filter.' }}</div>
</section>

<script src="{{ '/js/projects-filter.js' | url }}"></script>
